# Copie para backend/.env e preencha. O .env nunca vai para o Git.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# Fallback do servidor quando o modelo recusa um pedido ("default" liga, vazio desliga)
ANTHROPIC_FALLBACKS=default
# Caminho relativo à raiz do repositório (pasta data/ está no .gitignore)
DATABASE_URL=sqlite:///../data/job_copilot.db
