# Copie para backend/.env e preencha. O .env nunca vai para o Git.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# Opcional: modelo por operação (as que não aparecem usam ANTHROPIC_MODEL). Ver backend/evals/README.md
ANTHROPIC_MODELS=extract_job=claude-haiku-5-5,read_job_alert=claude-haiku-5-5,analyze_job=claude-haiku-5-5,generate_text=claude-sonnet-5-5,extract_claims=claude-sonnet-5-5
# Fallback do servidor quando o modelo recusa um pedido ("default" liga, vazio desliga)
ANTHROPIC_FALLBACKS=default
# Caminho relativo à raiz do repositório (pasta data/ está no .gitignore)
DATABASE_URL=sqlite:///../data/job_copilot.db

# E-mails de alerta de vagas (IMAP, só leitura). No Gmail: ative o IMAP e crie uma senha de app
# (Conta Google > Segurança > Verificação em duas etapas > Senhas de app). Nunca use a senha da conta.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Domínios dos remetentes lidos, quantos dias para trás e quantos e-mails novos por leitura
ALERT_SENDERS=linkedin.com,indeed.com,gupy.io,catho.com.br,infojobs.com.br,vagas.com.br,glassdoor.com
ALERT_DAYS=14
ALERT_MAX_EMAILS=20
